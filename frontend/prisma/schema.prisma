generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id                    String                  @id @default(uuid()) @db.Uuid
  firstName             String                  @map("first_name") @db.VarChar(80)
  lastName              String                  @map("last_name") @db.VarChar(80)
  phoneNumber           String                  @unique @map("phone_number") @db.VarChar(32)
  email                 String?                 @unique @db.VarChar(254)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  gender                String?                 @db.VarChar(32)
  maritalStatus         String?                 @map("marital_status") @db.VarChar(32)
  address               String?                 @db.VarChar(255)
  dateOfBirth           DateTime?               @map("date_of_birth") @db.Date
  employmentStatus      String?                 @map("employment_status") @db.VarChar(32)
  heardAboutChurch      String?                 @map("heard_about_church") @db.VarChar(32)
  heardAboutChurchOther String?                 @map("heard_about_church_other") @db.VarChar(120)
  purposeOfAttending    String?
  wouldLikeToBeMember   String?                 @map("would_like_to_be_member") @db.VarChar(16)
  firstTimer            Boolean                 @map("first_timer")
  connectName           String?                 @map("connect_name") @db.VarChar(80)
  dateJoined            DateTime                @default(now()) @map("date_joined") @db.Timestamptz(6)
  birthday              String?                 @db.VarChar(4)
  attendances           Attendance[]
  connect_group_members connect_group_members[]
  firstTimerLogs        FirstTimerEvent[]

  @@map("members")
}

model Service {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(80)
  theme            String?           @db.VarChar(80)
  location         String?           @db.VarChar(80)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  attendances      Attendance[]
  connectGroups    ConnectGroup[]
  firstTimerEvents FirstTimerEvent[]

  @@map("service")
}

model ConnectGroup {
  id                    String                  @id @default(uuid()) @db.Uuid
  serviceId             String?                 @map("service_id") @db.Uuid
  name                  String                  @db.VarChar(80)
  description           String                  @db.VarChar(254)
  meetingTime           String                  @map("meeting_time") @db.VarChar(80)
  meetingDay            String                  @map("meeting_day") @db.VarChar(20)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  service               Service?                @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  connect_group_members connect_group_members[]

  @@map("connect_group")
}

model Attendance {
  id          String   @id @default(uuid()) @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  serviceType String   @map("service_type") @db.VarChar(32)
  connectName String?  @map("connect_name") @db.VarChar(80)
  checkinCode String   @unique @map("checkin_code") @db.VarChar(32)
  serviceDate DateTime @map("service_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([memberId, serviceDate, serviceType, connectName], map: "uq_member_day_service_connect")
  @@map("attendance")
}

model ChatSession {
  id        String   @id @db.VarChar(64)
  stateJson String   @map("state_json")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("chat_sessions")
}

model FirstTimerEvent {
  id          String   @id @default(uuid()) @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  serviceType String   @map("service_type") @db.VarChar(32)
  serviceName String   @map("service_name") @db.VarChar(120)
  serviceDate DateTime @map("service_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([memberId, serviceDate, serviceName], map: "uq_first_timer_member_day_event")
  @@map("first_timer_events")
}


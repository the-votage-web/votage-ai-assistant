# =============================================================================
# Backend environment template
# -----------------------------------------------------------------------------
# Copy this file to ".env" (in this same backend/ folder) and fill in real
# values. The real .env is gitignored and must NEVER be committed — it holds
# secrets. This .example file is safe to commit because it has no real values.
#
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
# =============================================================================


# --- REQUIRED: Database (separate parameters; the app assembles the URL) -------
# The database must have the pgvector extension available (enabled on startup).
# For Neon, copy these from your project's Connection Details.
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_SSLMODE=require
# Optional Neon extras (leave blank if not needed):
DB_OPTIONS=
DB_CHANNEL_BINDING=


# --- REQUIRED for the FAQ chatbot: OpenAI -------------------------------------
# Powers BOTH steps of the chat: embeddings (search) and answer generation.
# Without a valid key the chat falls back to crude keyword matching only.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini


# --- Admin: secret to read chat logs at GET /api/faq/logs ---------------------
# Sent by the caller via the "X-Admin-Key" header. Leave blank to keep the
# chat-logs endpoint locked (deny by default).
ADMIN_API_KEY=


# --- Check-in / registration LLM (separate from the FAQ chat) -----------------
# Which provider the check-in intent-extractor uses: "bedrock" or "openai".
# If left as "bedrock" but no Bedrock model/credentials are set, it safely
# degrades to a local rule-based extractor (no crash, no AWS needed).
CHECKIN_LLM_PROVIDER=bedrock
OPENAI_CHECKIN_MODEL=gpt-4o-mini


# --- AWS Bedrock (OPTIONAL: only if CHECKIN_LLM_PROVIDER=bedrock) --------------
# Not required for FAQ-accuracy work. Leave blank to run without AWS.
AWS_REGION=us-east-1
# Set ONE of the following to enable Bedrock:
BEDROCK_MODEL_ID=
BEDROCK_PROFILE_ARN=
BEDROCK_PROVIDER=anthropic
BEDROCK_THROTTLE_COOLDOWN_SECONDS=600
# AWS auth (only needed if actually calling Bedrock):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# --- URLs & CORS --------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
REGISTRATION_PAGE_URL=http://localhost:3000/register
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000


# --- Misc ---------------------------------------------------------------------
# Optional simple check-in code gate. Change in production.
SUNDAY_CODE=change-me
# Whether to auto-create DB tables on startup.
AUTO_CREATE_TABLES=false


# --- Legacy / currently unused (kept for reference) ---------------------------
# These relate to an older Ollama/Chroma path that the live code no longer uses.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
CHROMA_PATH=./chroma
MEMBERS_COLLECTION=members
DOCS_COLLECTION=church_docs
